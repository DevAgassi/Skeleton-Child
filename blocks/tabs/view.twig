<section {{ wrapper_attrs|raw }}
	data-wp-interactive="tabs"
	{{ wp_context|raw }}
>
	<div>
		{% if block.title or block.subtitle %}
			<div class="tabs-header text-center mb-8">
				{% if block.title %}
					<h2 {{ acf_inline_text('title') }} class="text-h3 font-bold">{{ block.title }}</h2>
				{% endif %}
				{% if block.subtitle %}
					<p {{ acf_inline_text('subtitle') }} class="mt-3 text-lg text-text-secondary">{{ block.subtitle }}</p>
				{% endif %}
			</div>
		{% endif %}

		{% if block.tabs|length > 0 %}
			<div class="tabs-nav" role="tablist">
				{% for tab in block.tabs %}
					<button
						role="tab"
						data-wp-context='{"tabIndex":{{ tab.index }}}'
						data-wp-on--click="actions.selectTab"
						data-wp-class--is-active="callbacks.isActive"
						data-wp-bind--aria-selected="callbacks.isActive"
						class="tabs-nav__btn"
						{% if tab.index == 0 %}aria-selected="true"{% endif %}
					>
						{{ tab.label }}
					</button>
				{% endfor %}
			</div>

			{% for tab in block.tabs %}
				<div
					role="tabpanel"
					data-wp-context='{"tabIndex":{{ tab.index }}}'
					data-wp-bind--hidden="callbacks.isHidden"
					class="tabs-panel flow"
					{% if tab.index != 0 %}hidden{% endif %}
				>
					{{ tab.content|raw }}
				</div>
			{% endfor %}
		{% endif %}
	</div>
</section>
