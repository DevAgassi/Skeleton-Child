<section {{ wrapper_attrs|raw }}>
	{% if block.logos %}
		<div class="marquee-track">
			{% for i in 1..2 %}
				<div class="marquee-set"{% if i == 2 %} inert{% endif %}>
					{% for item in block.logos %}
						<div class="marquee-item">
							{% if item.link %}
								<a href="{{ item.link }}" target="_blank" rel="noopener noreferrer">
							{% endif %}
							<img
								src="{{ item.src }}"
								alt="{{ item.alt }}"
								width="120"
								height="32"
								loading="lazy"
							>
							{% if item.link %}
								</a>
							{% endif %}
						</div>
					{% endfor %}
				</div>
			{% endfor %}
		</div>
	{% endif %}
</section>
