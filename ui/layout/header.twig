{% block header %}
	{# child-shadow-marker: this file overrides the parent ui/layout/header.twig #}
	<div class="site-header-spacer"></div>
	<header class="site-header" data-header data-child-header>
		<div class="container">
			<div class="site-header-inner">
				{# ── Logo ── #}
				<div class="shrink-0">{{ function('get_custom_logo')|raw }}</div>

				{# ── Desktop nav (1280px+) ── #}
				<nav class="hidden xl:flex flex-1 justify-center" aria-label="{{ __('Main navigation', 'skeleton') }}">
					<ul class="flex items-stretch gap-1">
						{% include 'ui/components/menu.twig' with { items: header_menu.get_items, mobile: false } %}
					</ul>
				</nav>

				{# ── Actions ── #}
				<div class="flex items-center gap-2">
					{% if options.header_cta %}
						<a
							href="{{ options.header_cta.url }}"
							class="hidden xl:inline-flex btn btn-primary btn-sm uppercase"
							{% if options.header_cta.target %}target="{{ options.header_cta.target }}" rel="noopener noreferrer"{% endif %}
						>
							{{ options.header_cta.title }}
						</a>
					{% endif %}

					<button
						popovertarget="mobile-menu"
						class="btn btn-ghost btn-sm btn-square xl:hidden!"
						aria-label="{{ __('Open menu', 'skeleton') }}"
					>
						<svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8M4 18h16"/>
						</svg>
					</button>
				</div>
			</div>
		</div>
	</header>

	{# ── Mobile menu: native popover ── #}
	<div id="mobile-menu" popover>
		<div class="flex flex-col h-full bg-base-100 w-full">
			<div class="flex items-center justify-between px-4 py-3 border-b border-base-300">
				<span class="font-semibold">{{ __('Menu', 'skeleton') }}</span>
				<button
					popovertarget="mobile-menu"
					popovertargetaction="hide"
					class="btn btn-ghost btn-sm btn-square"
					aria-label="{{ __('Close menu', 'skeleton') }}"
				>
					<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
					</svg>
				</button>
			</div>

			<nav class="flex-1 overflow-y-auto p-3">
				<ul class="flex flex-col gap-1 w-full">
					{% include 'ui/components/menu.twig' with { items: header_menu.get_items, mobile: true } %}
				</ul>
			</nav>

			{% if options.header_cta %}
				<div class="p-4 border-t border-base-300">
					<a
						href="{{ options.header_cta.url }}"
						class="btn btn-primary w-full uppercase"
						{% if options.header_cta.target %}target="{{ options.header_cta.target }}" rel="noopener noreferrer"{% endif %}
					>
						{{ options.header_cta.title }}
					</a>
				</div>
			{% endif %}
		</div>
	</div>
{% endblock %}
